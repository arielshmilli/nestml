# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with NEST.  If not, see <http://www.gnu.org/licenses/>.
#
model delayed_convolution_synapse:
    state:
        w real = 1
        c_sum_at_pre real = 0     # sum of the values of c at the presynaptic spikes
        c2_sum_at_pre real = 0
        c_sum_at_post real = 0    # sum of the values of c at the postsynaptic spikes
        c2_sum_at_post real = 0
        c_integral ms = 0 ms      # integral of c over time, up to the most recent presynaptic spike
        c2_integral ms = 0 ms

    parameters:
        tau_c ms = 48.8 ms
        c_delay ms = 18.8 ms
        c2_delay ms = 7.3 ms

    equations:
        kernel K = exp(-t / tau_c)
        inline c real = convolve(K, pre_spikes(t - c_delay))
        inline c2 real = convolve(K, pre_spikes(t - c2_delay))

    input:
        pre_spikes <- spike
        post_spikes <- spike

    output:
        spike

    onReceive(pre_spikes):
        c_sum_at_pre += c
        c2_sum_at_pre += c2
        emit_spike(w)

    onReceive(post_spikes):
        c_sum_at_post += c
        c2_sum_at_post += c2

    update:
        # c and c2 hold their values at the start of the interval; exact as long as no release falls inside it
        c_integral += c * tau_c * (1 - exp(-timestep() / tau_c))
        c2_integral += c2 * tau_c * (1 - exp(-timestep() / tau_c))
