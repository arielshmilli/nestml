#
model delayed_convolution_neuron:
    state:
        V_m mV = 0 mV

    equations:
        kernel I_kernel = (e / tau_syn) * t * exp(-t / tau_syn)
        recordable inline I_syn pA = unit_psc * (convolve(I_kernel, spikes) + 2 * convolve(I_kernel, spikes(t - kernel_delay)))
        V_m' = -V_m / tau_m + I_syn / C_m

    parameters:
        C_m pF = 250 pF
        tau_m ms = 10 ms
        tau_syn ms = 2 ms
        kernel_delay ms = 5 ms

    internals:
        unit_psc pA = 1 pA

    input:
        spikes <- spike

    update:
        integrate_odes()


model delayed_convolution_reference_neuron:
    state:
        V_m mV = 0 mV

    equations:
        kernel I_kernel = (e / tau_syn) * t * exp(-t / tau_syn)
        recordable inline I_syn pA = unit_psc * convolve(I_kernel, spikes)
        V_m' = -V_m / tau_m + I_syn / C_m

    parameters:
        C_m pF = 250 pF
        tau_m ms = 10 ms
        tau_syn ms = 2 ms

    internals:
        unit_psc pA = 1 pA

    input:
        spikes <- spike

    update:
        integrate_odes()


model delayed_convolution_nonlinear_neuron:
    state:
        V_m mV = 0 mV

    equations:
        kernel I_kernel = exp(-t / tau_syn)
        recordable inline I_syn pA = unit_psc * (convolve(I_kernel, spikes) + 2 * convolve(I_kernel, spikes(t - kernel_delay)))
        V_m' = -V_m / tau_m - V_m * V_m / (V_scale * tau_m) + I_syn / C_m

    parameters:
        C_m pF = 250 pF
        tau_m ms = 10 ms
        tau_syn ms = 2 ms
        V_scale mV = 10 mV
        kernel_delay ms = 5 ms

    internals:
        unit_psc pA = 1 pA

    input:
        spikes <- spike

    update:
        integrate_odes()


model delayed_convolution_nonlinear_reference_neuron:
    state:
        V_m mV = 0 mV

    equations:
        kernel I_kernel = exp(-t / tau_syn)
        recordable inline I_syn pA = unit_psc * convolve(I_kernel, spikes)
        V_m' = -V_m / tau_m - V_m * V_m / (V_scale * tau_m) + I_syn / C_m

    parameters:
        C_m pF = 250 pF
        tau_m ms = 10 ms
        tau_syn ms = 2 ms
        V_scale mV = 10 mV

    internals:
        unit_psc pA = 1 pA

    input:
        spikes <- spike

    update:
        integrate_odes()
