# CoCoDelayedConvolution.nestml
# #############################
#
#
# Description
# +++++++++++
#
# This model is used to test the checks for convolutions with a delayed spike input port, ``convolve(K, spikes(t - d))``.
#
# Positive case.
#
#
model CoCoDelayedConvolution:
    state:
        V_m mV = 0 mV

    equations:
        kernel K = exp(-t / tau)
        inline I pA = convolve(K, spikes) * unit_psc + convolve(K, spikes(t - d)) * unit_psc
        V_m' = -V_m / tau + I / C_m

    parameters:
        tau ms = 10 ms
        d ms = 2 ms
        C_m pF = 250 pF

    internals:
        unit_psc pA = 1 pA

    input:
        spikes <- spike

    update:
        integrate_odes()
